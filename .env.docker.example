# Shared Risk, Orchestrator, and Docker Compose configuration:
#   cp .env.docker.example .env
#
# Do NOT commit .env to git.

# --- Admin UI (runtime config API) ---
ADMIN_API_KEY=change-me-to-a-long-random-secret

# --- PostgreSQL (shared by Risk + Orchestrator) ---
POSTGRES_USER=afs
POSTGRES_PASSWORD=""
POSTGRES_HOST=localhost
POSTGRES_DB=afs
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_PORT=5434

# --- iGaming operator ---
PLATFORM_NAME=casino
LICENSED_MARKETS=DE,MT,GB,SE,FI,NL,AT,IE

# --- IP intelligence ---
IP_INTEL_ENABLED=true
IP_INTEL_CACHE_TTL_SECONDS=86400
IP_INTEL_TIMEOUT_SECONDS=3.0
IP_INTEL_FAIL_OPEN=true

# --- Sync API ---
SYNC_PUBLISH_AUDIT=true
DECISION_CACHE_TTL_SECONDS=60
EVALUATE_FILE_LOG_ENABLED=true
EVALUATE_FILE_LOG_PATH=../data/evaluate-requests.jsonl

# --- Redis ---
REDIS_PASSWORD=""
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_DB=0
REDIS_VELOCITY_IP_TTL=3600
REDIS_VELOCITY_DOMAIN_TTL=86400

# --- Decision thresholds ---
DECISION_BLOCK_THRESHOLD=81
DECISION_CHALLENGE_THRESHOLD=31

# --- AML blocklist ---
AML_BLOCKLIST_BACKGROUND_SYNC=true

# --- RabbitMQ ---
RABBITMQ_USER=afs_mq_prod
RABBITMQ_PASSWORD=""
RABBITMQ_HOST=localhost
RABBITMQ_VHOST=/
RABBITMQ_ENABLED=true
RABBITMQ_PUBLISH_RESULTS=true
RABBITMQ_IMAGE=rabbitmq:4-management-alpine
RABBITMQ_PORT=5674
RABBITMQ_MANAGEMENT_PORT=15674
RABBITMQ_EVENTS_EXCHANGE=casino.events
RABBITMQ_EVENTS_EXCHANGE_TYPE=topic
RABBITMQ_EVENTS_QUEUE=casino.afs
RABBITMQ_EVENTS_BINDING_KEY=#
RABBITMQ_RESULTS_QUEUE=risk.results
RABBITMQ_ACTIONS_QUEUE=risk.actions
RABBITMQ_PREFETCH=10

# --- Optional port overrides (omit to use defaults) ---
# RISK_PORT=8001
# ORCHESTRATOR_PORT=8002
