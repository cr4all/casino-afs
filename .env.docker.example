# Docker Compose secrets — copy to .env in the repo root:
#   cp .env.docker.example .env
#
# docker compose automatically loads .env from this directory.
# Do NOT commit .env to git.

# --- PostgreSQL (shared by Risk + Orchestrator) ---
POSTGRES_USER=afs
POSTGRES_PASSWORD=""
POSTGRES_DB=afs

# Quote passwords that contain # — unquoted # starts a comment in .env files.
REDIS_PASSWORD=""

REDIS_ENABLED=true

# --- RabbitMQ (bundled in docker-compose; port 5672 exposed for remote casino backends) ---
# Change these before production — keep in sync with docker-compose defaults or override both.
RABBITMQ_USER=afs_mq_prod
RABBITMQ_PASSWORD=""
RABBITMQ_VHOST=/

# Optional port overrides
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672

RABBITMQ_ENABLED=true
RABBITMQ_PUBLISH_RESULTS=true

# Remote casino backend connection string (replace YOUR_PUBLIC_IP):
# amqp://afs_mq_prod:MqPubl1c_AFS!2026_Kx9mP2vL7nQw8zR4@YOUR_PUBLIC_IP:5672/

# --- Optional port overrides (omit to use defaults) ---
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# RISK_PORT=8001
# ORCHESTRATOR_PORT=8002

# --- Admin UI ---
# ADMIN_API_KEY=your-admin-key
