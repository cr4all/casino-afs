# Copy to .env and adjust for your environment:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)

# --- Admin UI (runtime config API) ---
# Required to access http://localhost:8001/admin
ADMIN_API_KEY=change-me-to-a-long-random-secret

# --- Database (shared with Orchestrator) ---
# Local SQLite (default). File: AFS/data/afs_risk.db
DATABASE_URL=sqlite:///../data/afs_risk.db
# Production example:
# DATABASE_URL=postgresql://user:password@localhost:5432/afs

# --- iGaming operator ---
PLATFORM_NAME=casino
LICENSED_MARKETS=DE,MT,GB,SE,FI,NL,AT,IE

# --- IP intelligence (free tier: ip-api.com + ippriv.com fallback) ---
IP_INTEL_ENABLED=true
IP_INTEL_CACHE_TTL_SECONDS=86400
IP_INTEL_TIMEOUT_SECONDS=3.0
IP_INTEL_FAIL_OPEN=true

# --- Sync API ---
SYNC_PUBLISH_AUDIT=true
DECISION_CACHE_TTL_SECONDS=60
# Request/response logging (sync + async) is configured in Admin UI → Logs tab.

# --- Redis (velocity counters + optional decision cache) ---
# Use in-memory velocity when false (fine for local dev, single instance)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_VELOCITY_IP_TTL=3600
REDIS_VELOCITY_DOMAIN_TTL=86400

# --- Decision thresholds (informational; scoring uses engine aggregation) ---
DECISION_BLOCK_THRESHOLD=81
DECISION_CHALLENGE_THRESHOLD=31

# --- RabbitMQ — casino platform subscription (inbound) ---
# Exchange: casino.events (topic) → Queue: casino.afs → Binding: #
# AFS skips non-risk events (bonus, chat, etc.) and scores risk event types only.
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EVENTS_EXCHANGE=casino.events
RABBITMQ_EVENTS_EXCHANGE_TYPE=topic
RABBITMQ_EVENTS_QUEUE=casino.afs
RABBITMQ_EVENTS_BINDING_KEY=#
RABBITMQ_PREFETCH=10

# Legacy mode (default exchange, no topic binding):
# RABBITMQ_EVENTS_EXCHANGE=
# RABBITMQ_EVENTS_QUEUE=risk.events

# --- RabbitMQ — outbound results to Orchestrator ---
RABBITMQ_PUBLISH_RESULTS=true
RABBITMQ_RESULTS_QUEUE=risk.results

# --- Local dev: sync API only (no RabbitMQ required) ---
# RABBITMQ_ENABLED=false
# RABBITMQ_PUBLISH_RESULTS=false
