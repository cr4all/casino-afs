# Copy to .env and adjust for your environment:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)

# --- Database (must match Risk service) ---
DATABASE_URL=sqlite:///../data/afs_risk.db
# Production example:
# DATABASE_URL=postgresql://user:password@localhost:5432/afs

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Inbound: scoring results from Risk service
RABBITMQ_RESULTS_QUEUE=risk.results

# Outbound: enforcement actions for your casino platform
RABBITMQ_ACTIONS_QUEUE=risk.actions

RABBITMQ_PREFETCH=10
